# Fontes: bloqueia genericamente para não commitar fontes proprietárias por acidente,
# mas libera as DejaVu (SIL OFL, livres) que garantem suporte a acentos no card do IG.
static/fonts/*.ttf
static/fonts/*.otf
!static/fonts/README.md
!static/fonts/DejaVuSans-Bold.ttf
!static/fonts/DejaVuSans.ttf
!static/fonts/DejaVuSansMono-Bold.ttf
!static/fonts/DejaVuSansMono.ttf

