# ==========================================================================
# IANoticias — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.
# ==========================================================================

# --- Banco de dados (Supabase Postgres) --------------------------------------
# Use a connection string do Supabase. Há duas opções:
#
# 1) Conexão DIRETA (porta 5432) — ideal para migrations/scripts locais:
#    postgresql+asyncpg://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
#
# 2) Pooler / PgBouncer (porta 6543, transaction mode) — recomendado para
#    serverless (Vercel). ATENÇÃO: com PgBouncer é obrigatório desabilitar o
#    cache de prepared statements do asyncpg, senão a conexão quebra. O código
#    já injeta statement_cache_size=0 quando detecta a porta 6543, mas você
#    também pode forçar via query string:
#    postgresql+asyncpg://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:senha@db.projeto.supabase.co:5432/postgres

# --- Supabase Storage (upload dos cards PNG) ---------------------------------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key (NUNCA expor no front)
SUPABASE_STORAGE_BUCKET=ianoticias-cards  # bucket PÚBLICO

# --- OpenAI (resumo/classificação) -------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini                   # modelo custo-eficiente (default)

# --- Instagram / Meta Graph API ----------------------------------------------
IG_USER_ID=1784xxxxxxxxxxx                 # ID da conta IG Business/Creator
IG_ACCESS_TOKEN=EAAG...                     # token de longa duração (ver README)
META_APP_ID=1234567890
META_APP_SECRET=abcdef...
GRAPH_API_VERSION=v21.0

# --- Legenda / crescimento no Instagram --------------------------------------
IG_HANDLE=seuperfil               # sem @; usado no CTA "Siga @seuperfil"
IG_BRAND_HASHTAG=IANoticias       # sem #; hashtag fixa da marca em todo post
IG_HASHTAGS_IN_COMMENT=1          # 1 = hashtags vão no 1º comentário (legenda limpa)

# --- Aplicação ----------------------------------------------------------------
ADMIN_PASSWORD=troque-esta-senha           # protege /api/ingest e /api/instagram/publish
SESSION_SECRET=gere-uma-string-aleatoria-longa   # assina o cookie de sessão
PUBLIC_SITE_URL=https://ianoticias.vercel.app    # usada em links absolutos

# --- Ajustes do pipeline / limites -------------------------------------------
INGEST_MAX_ITEMS=12       # cap de itens processados por clique (evita timeout na Vercel)
INGEST_FEED_TIMEOUT=8     # timeout (s) por fetch/validação de cada matéria
FEATURED_PER_CATEGORY=4   # quantos itens marcar como featured por categoria/dia
INGEST_VALIDATE_LINKS=1   # 1 = descarta matérias cujo link não responde 2xx (evita links quebrados)

# --- Modos de mock (rodar local sem chamar APIs externas) --------------------
MOCK_LLM=0               # 1 = não chama OpenAI, gera resumo fake determinístico
MOCK_IG=0               # 1 = não chama Meta, simula publicação
MOCK_STORAGE=0          # 1 = não faz upload no Supabase, usa /static local
